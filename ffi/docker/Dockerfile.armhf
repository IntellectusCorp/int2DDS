# int2dds-ffi armhf builder (armv7 gnueabihf, glibc 2.35 / Ubuntu 22.04)
#
# armhf does NOT use the manylinux_2_28 image the other gnu targets use:
# manylinux publishes no armv7 image, and every lower-glibc armhf builder is
# unmaintained (debian 10 archived, debian 11 LTS ends 2026-08-31, ubuntu 20.04
# EOL). So armhf stays where it already was, at floor 2.35 — this is a deferred
# improvement, not a regression. armhf has no RHEL and is not a ROS 2 tier 1
# platform, so nothing in the target matrix needs a lower floor here.
#
# Mirrors the armhf path in .github/workflows/release.yml.

FROM ubuntu:22.04

ARG RUST_VERSION=1.89.0
ENV DEBIAN_FRONTEND=noninteractive \
    RUSTUP_HOME=/usr/local/rustup \
    CARGO_HOME=/usr/local/cargo \
    PATH=/usr/local/cargo/bin:$PATH

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        build-essential cmake perl clang libclang-dev curl ca-certificates pkg-config \
    && rm -rf /var/lib/apt/lists/*

RUN curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs \
        | sh -s -- -y --no-modify-path --profile minimal --default-toolchain ${RUST_VERSION} \
    && rustc --version && rustc -vV | grep host

WORKDIR /src

ENV DIST=unknown \
    CARGO_TARGET_DIR=/tmp/cargo-target

# Same emitted layout as the manylinux Dockerfile, so build-ffi-linux.ps1's
# artifact checks work unchanged. No `pipefail`: diagnostic pipes raise SIGPIPE
# under QEMU and would be mistaken for a build failure (exit 141).
CMD ["bash", "-lc", "\
    set -eu; \
    echo \"== platform: $(uname -m)  ->  dist/$DIST ==\"; \
    ldd --version | head -1 || true; rustc -vV | grep host || true; \
    cargo build --release -p int2dds-ffi; \
    ver=$(grep -m1 '^version' /src/Cargo.toml | cut -d'\"' -f2); \
    maj=${ver%%.*}; \
    real=libint2dds_ffi.so.$ver; son=libint2dds_ffi.so.$maj; \
    out=/src/ffi/dist/$DIST; mkdir -p \"$out\"; \
    cp -v \"$CARGO_TARGET_DIR/release/libint2dds_ffi.so\" \"$out/$real\"; \
    ln -sfn \"$real\" \"$out/$son\"; \
    ln -sfn \"$son\" \"$out/libint2dds_ffi.so\"; \
    cp -v /src/ffi/include/int2dds-ffi.h /src/ffi/dist/ 2>/dev/null || true; \
    echo '== artifact =='; \
    readelf -h \"$out/$real\" | grep -E 'Class|Machine|Type' || true; \
    echo '== embedded SONAME (should be '$son') =='; \
    readelf -d \"$out/$real\" | grep SONAME || true; \
    echo '== max GLIBC symbol version required (must be <= 2.35) =='; \
    { objdump -T \"$out/$real\" | grep -oE 'GLIBC_[0-9.]+' | sort -V | tail -1; } || true \
    "]
