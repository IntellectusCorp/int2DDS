<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net45;netstandard2.0;netstandard2.1;net6.0;net8.0</TargetFrameworks>
    <ImplicitUsings>disable</ImplicitUsings>
    <RootNamespace>Int2Dds</RootNamespace>
    <AssemblyName>Int2Dds</AssemblyName>

    <!-- Package metadata -->
    <PackageId>Int2Dds</PackageId>
    <Version>0.1.0</Version>
    <Authors>IntellectusCorp</Authors>
    <Description>C# binding for int2DDS - a high-performance DDS implementation</Description>
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
  </PropertyGroup>

  <!-- net45: relax nullable to annotations only (no enforcement); attributes provided by PolySharp -->
  <PropertyGroup Condition="'$(TargetFramework)' == 'net45'">
    <Nullable>annotations</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Int2Dds.Tests" />
  </ItemGroup>

  <!-- Existing async/unsafe NuGets: NOT used on net45 (Async/ folder excluded; Unsafe usage replaced) -->
  <ItemGroup Condition="'$(TargetFramework)' != 'net45'">
    <PackageReference Include="Microsoft.Bcl.AsyncInterfaces" Version="6.0.0" />
    <PackageReference Include="System.Runtime.CompilerServices.Unsafe" Version="6.0.0" />
  </ItemGroup>

  <!-- Span<T>/Memory<T> for netstandard2.0 only (net45 uses byte[]-based fallbacks instead) -->
  <ItemGroup Condition="'$(TargetFramework)' == 'netstandard2.0'">
    <PackageReference Include="System.Memory" Version="4.5.5" />
  </ItemGroup>

  <!-- net45 build-time only: reference assemblies (the SDK doesn't ship these) and C# 8 attribute polyfills.
       PrivateAssets="all" ensures these do NOT propagate to consumers nor end up as runtime dependencies. -->
  <ItemGroup Condition="'$(TargetFramework)' == 'net45'">
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies.net45" Version="1.0.3" PrivateAssets="all" />
    <PackageReference Include="PolySharp" Version="1.14.1" PrivateAssets="all" />
  </ItemGroup>

  <!-- Async/ folder requires IAsyncEnumerable / ValueTask which are not available on net45. -->
  <ItemGroup Condition="'$(TargetFramework)' == 'net45'">
    <Compile Remove="Async/**/*.cs" />
  </ItemGroup>

</Project>
