<Project>
  <!--
    ┌──────────────────────────────────────────────────────────────┐
    │  int2DDS C# Binding – Target Framework Configuration        │
    │                                                              │
    │  Library (Int2Dds):       netstandard2.1                     │
    │  Tests / Examples:        net6.0                             │
    │  Language Version:        C# 8.0                             │
    │                                                              │
    │  The library targets netstandard2.1 for maximum              │
    │  compatibility (.NET Core 3.0+, .NET 5+, .NET 6+,           │
    │  .NET 8+, Unity 2021+, Xamarin, MAUI).                      │
    │  Test and example projects target net6.0 as the minimum      │
    │  runnable framework that supports netstandard2.1.            │
    └──────────────────────────────────────────────────────────────┘
  -->
  <PropertyGroup>
    <LangVersion>8.0</LangVersion>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <!--
    Version single source of truth: the workspace version in the repo-root
    Cargo.toml ([workspace.package].version). We read it here so the C# binding
    always matches int2dds without manual syncing. To bump the product version,
    edit ONLY ../Cargo.toml.
  -->
  <PropertyGroup Condition="Exists('$(MSBuildThisFileDirectory)../Cargo.toml')">
    <_Int2DdsCargoToml>$([System.IO.File]::ReadAllText('$(MSBuildThisFileDirectory)../Cargo.toml'))</_Int2DdsCargoToml>
    <Version>$([System.Text.RegularExpressions.Regex]::Match($(_Int2DdsCargoToml), 'version\s*=\s*"([^"]+)"').Groups.get_Item(1).Value)</Version>
  </PropertyGroup>
  <!-- Fallback when built outside the repo tree (e.g. from a standalone NuGet source drop). -->
  <PropertyGroup Condition="!Exists('$(MSBuildThisFileDirectory)../Cargo.toml')">
    <Version Condition="'$(Version)' == ''">0.0.0</Version>
  </PropertyGroup>
</Project>
